{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/http.ts",
    "src/stdio.ts",
    "src/node-config.ts",
    "src/oauth-provider.ts",
    "src/oauth-store.ts",
    "src/**/*.test.ts"
  ]
}
